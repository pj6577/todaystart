{
  "extends": "plasmo/templates/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": { "~*": ["./src/*"] },
    "types": ["chrome", "node", "vitest/globals"],
    "resolveJsonModule": true
  },
  "include": ["src", "tests", "*.ts", ".plasmo/index.d.ts"],
  "exclude": ["node_modules", "build"]
}
